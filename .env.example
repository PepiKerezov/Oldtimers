# --- Database ---
# DATABASE_PASSWORD is only consumed by docker-compose.yml to start the local
# dev Postgres container. Not needed on a managed host (Neon/Vercel) — the
# password is already inside the connection strings below.
DATABASE_PASSWORD=
# Local dev: the Docker Postgres. Production: the managed provider's POOLED
# (PgBouncer / Neon pooler) connection string. Used by the running app.
DATABASE_URL=postgresql://oldtimers:${DATABASE_PASSWORD}@localhost:5432/oldtimers?schema=public
# Production only: the DIRECT (non-pooled) connection string. Used by
# `prisma migrate deploy` during the build. Leave blank for local Docker dev.
DIRECT_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
# Public origin. Local dev: http://localhost:3000. Production: the real
# domain, e.g. https://oldtimers.online — must match how users reach the site.
BETTER_AUTH_URL=http://localhost:3000

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Sentry (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Runtime ---
NODE_ENV=development
