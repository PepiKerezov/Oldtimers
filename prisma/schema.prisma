// Old Timer's — Prisma schema
// Better Auth manages User/Account/Session/Verification (with admin plugin fields).
// Domain tables: Article, Order, ContactSubmission.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  CONTACTED
  SOURCING
  QUOTED
  COMPLETED
  CANCELLED
}

enum ArticleCategory {
  novini
  istoriya
  lyubopitni
  saveti
}

// --- Better Auth core (with admin plugin fields) ---

model User {
  id            String    @id
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  // admin plugin fields
  role          String    @default("USER")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  articles      Article[] @relation("ArticleAuthor")

  @@index([role])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id              String   @id
  userId          String
  token           String   @unique
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  // admin plugin
  impersonatedBy  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- Domain tables ---

model Article {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  excerpt      String
  category     ArticleCategory
  coverImage   String?
  content      Json
  published    Boolean         @default(false)
  publishedAt  DateTime?
  authorId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  author       User?           @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@index([category])
}

model Order {
  id            String      @id @default(cuid())
  carMake       String
  carModel      String
  carYear       Int
  partDesc      String
  customerName  String
  email         String
  phone         String
  notes         String?
  status        OrderStatus @default(NEW)
  ipAddress     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model ContactSubmission {
  id         String   @id @default(cuid())
  name       String
  email      String
  message    String
  handled    Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([handled, createdAt])
}
